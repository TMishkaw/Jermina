# Environment
JEMINI_ENV=dev

# Database (PostgreSQL + pgvector)
POSTGRES_DB=jemini
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/jemini

# Gemini API Keys pool (comma-separated or list)
GEMINI_API_KEYS=[]
GEMINI_PRIMARY_MODEL=gemini-2.5-flash
GEMINI_LIVE_MODEL=gemini-3.8-live

# API Server
API_HOST=0.0.0.0
API_PORT=8000
